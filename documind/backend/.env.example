# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Comma-separated list of frontend origins allowed by CORS
ALLOWED_ORIGINS=http://localhost:5173

# Retrieval settings
TOP_K=5
# Leave SCORE_THRESHOLD unset to use the default for your embedder (0.45 for bge-small).
# Tune it with: python eval/run_eval.py --sweep
# SCORE_THRESHOLD=0.45
CHUNK_WORDS=500
CHUNK_OVERLAP=80

# Uploads
MAX_UPLOAD_MB=10

# "fastembed" (default, needs to download the model once) or "hashing" (offline, lower quality)
EMBEDDING_BACKEND=fastembed
